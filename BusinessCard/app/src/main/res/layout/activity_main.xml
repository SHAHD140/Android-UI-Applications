
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F1EA">

    <TextView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:gravity="center"
        android:background="#30475E"
        android:text="S"
        android:textSize="55sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:text="Shahd Abu Ramadan"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#30475E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Web Developer"
        android:textSize="20sp"
        android:textColor="#718096" />

    <View
        android:layout_width="90dp"
        android:layout_height="2dp"
        android:layout_marginTop="28dp"
        android:background="#C9A77A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="Website Design &amp; Development"
        android:textSize="18sp"
        android:textColor="#30475E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Creating modern and user-friendly websites"
        android:textSize="16sp"
        android:textColor="#718096" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:gravity="center"
        android:text="CONTACT"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#30475E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Palestine"
        android:textSize="17sp"
        android:textColor="#455A64" />

</LinearLayout>
